# Backend environment (Docker Compose / local)
DATABASE_URL=postgresql+asyncpg://freight:freight_dev_password@localhost:5432/freight
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=false
JWT_SECRET_KEY=change-me-in-production-use-a-32-byte-minimum-secret
CSRF_SECRET_KEY=development-only-csrf-secret-change-in-production
FIELD_ENCRYPTION_KEY=development-only-field-key-change-in-production
SETUP_TOKEN=
AUTH_RETURN_TOKENS=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_REFRESH_TOKEN_EXPIRE_HOURS=12
PASSWORD_MIN_LENGTH=8
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Google Sheets backup scheduler (configure credentials in Settings > Backup)
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_TICK_SECONDS=60

# Storage: local | s3 (MinIO or any S3-compatible store)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=freight-attachments
S3_REGION=us-east-1
S3_USE_SSL=false
STORAGE_PRESIGNED_UPLOADS_ENABLED=true
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,xlsx,docx
PRESIGNED_URL_EXPIRE_SECONDS=300

# PostgreSQL connection pool (ignored by SQLite tests).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
