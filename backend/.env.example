# Backend environment (Docker Compose / local)
DATABASE_URL=postgresql+asyncpg://freight:freight_dev_password@localhost:15432/freight
REDIS_URL=redis://localhost:16379/0
REDIS_ENABLED=true
JWT_SECRET_KEY=change-me-in-production-use-a-32-byte-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Storage: local | s3 (MinIO or any S3-compatible store)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:19000
S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=freight-attachments
S3_REGION=us-east-1
S3_USE_SSL=false
