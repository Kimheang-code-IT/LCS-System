# Copy to .env and adjust.
# Local defaults below reach the app at http://localhost.

# --- Host ports ------------------------------------------------------------
FRONTEND_HOST_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Which host interface internal services bind to. Use 127.0.0.1 in production
# so Postgres/Redis/MinIO/backend are not exposed to the internet.
BIND_HOST=0.0.0.0

# nginx config file mounted into the frontend container:
#   default.conf    -> HTTP only (local dev, and TLS bootstrap)
#   production.conf -> HTTPS (after the certificate exists)
NGINX_CONF=default.conf

# --- Database --------------------------------------------------------------
POSTGRES_DB=freight
POSTGRES_USER=freight
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_32_CHAR_MINIMUM
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false

# --- Object storage (MinIO) ------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=freight-attachments
S3_REGION=us-east-1
STORAGE_PROVIDER=s3
# Internal (container-to-container) endpoint.
S3_ENDPOINT_URL=http://minio:9000
# Browser-facing endpoint used to sign attachment URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_USE_SSL=false

# ===========================================================================
# Production example (AWS EC2, https://lcslog.minidev.in)
# ===========================================================================
# NOTE: On EC2 the production .env is GENERATED by
# .github/workflows/production.yml into /opt/lcs/.env from the GitHub
# "production" environment secrets/variables (chmod 600, never committed).
# The values below document what it contains; never commit a real .env.
#
# ENVIRONMENT=production
# DEBUG=false
# BIND_HOST=127.0.0.1
# NGINX_CONF=production.conf
# POSTGRES_PASSWORD=<strong-random>
# JWT_SECRET_KEY=<openssl rand -hex 32>
# MINIO_ROOT_USER=<random>
# MINIO_ROOT_PASSWORD=<strong-random>
# COOKIE_SECURE=true
# CORS_ORIGINS=https://lcslog.minidev.in
# NUXT_PUBLIC_SITE_URL=https://lcslog.minidev.in
# NUXT_PUBLIC_AUTH_MODE=cookie
# S3_PUBLIC_ENDPOINT_URL=https://lcslog.minidev.in
#
# MinIO is internal to the Docker network; the main-domain nginx proxies the
# bucket path (/freight-attachments/) to minio:9000 for presigned URLs.
#
# Images published by GitHub Actions to GHCR (docker-compose.prod.yml).
# IMAGE_TAG is overridden by the deploy workflow; pin it to roll back.
# IMAGE_PREFIX=ghcr.io/kimheang-code-it/lcs-system
# IMAGE_TAG=latest
