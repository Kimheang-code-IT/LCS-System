# Copy to .env and adjust.
# The frontend uses the nginx default port 80 (http://localhost).
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

POSTGRES_DB=freight
POSTGRES_USER=freight
POSTGRES_PASSWORD=CHANGE_ME

# Auth — access JWT lasts a full day (1440 minutes); refresh lasts 30 days.
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_32_CHAR_MINIMUM
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=freight-attachments
